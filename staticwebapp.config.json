{
  "platform": {
    "apiRuntime": "python:3.11"
  },
  "routes": [
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/403.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*", "allowedRoles": ["admin"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=/",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html"
    }
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow",
    "X-Frame-Options": "DENY"
  }
}
